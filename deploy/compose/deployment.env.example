# Copy to deployment.env and fill in real values. Never commit deployment.env.

# Image to run — a tag or immutable @sha256 digest published by release.yml
IMAGE_REF=ghcr.io/ai-artel/demo-nodejs:REPLACE_WITH_TAG_OR_DIGEST

# Host port to publish (Dokploy overrides/ignores this when it manages the domain itself)
HOST_PORT=3000

# --- Runtime configuration (see root README.md#configuration for the full list) ---
NODE_ENV=production
PORT=3000
DISABLE_METRICS=false
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_SECRET=REPLACE_WITH_A_REAL_SECRET
